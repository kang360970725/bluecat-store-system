{
  "name": "@bluecat/server",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "prisma": "prisma",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "test:v2-regression": "ts-node -r tsconfig-paths/register src/modules/v2-data-platform/regression.ts && ts-node src/modules/v2-attendance/attendance-code.regression.ts && ts-node src/modules/v2-operations/usage-analytics-cache.regression.ts && ts-node src/modules/v2-operations/schedule-cycle.regression.ts && ts-node src/common/direct-account-access.regression.ts && ts-node -r tsconfig-paths/register src/modules/v2-operations/store-center-ranking.regression.ts",
    "test:v2-revenue-contract": "ts-node -r tsconfig-paths/register src/modules/v2-data-platform/revenue-contract.regression.ts",
    "test:v2-shift-contract": "ts-node -r tsconfig-paths/register src/modules/v2-data-platform/shift-contract.regression.ts",
    "v2:backfill": "ts-node -r tsconfig-paths/register src/scripts/v2-x-manager-backfill.ts"
  },
  "dependencies": {
    "@bluecat/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.34",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.11.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}

