  scheduledFor DateTime? @map("scheduled_for")
  schedule V2OperationalTaskSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  evidence V2OperationalTaskEvidence[]
  evidenceDrafts V2OperationalTaskEvidenceDraft[]
  reviewMode V2OperationalTaskReviewMode @default(REQUIRED) @map("review_mode")
  sourceTaskId String? @map("source_task_id")
  sourceTask V2OperationalTask? @relation("V2OperationalTaskRectifications", fields: [sourceTaskId], references: [id], onDelete: Restrict)
  rectifications V2OperationalTask[] @relation("V2OperationalTaskRectifications")
  reopenHistory V2OperationalTaskReopen[]
  originalDueAt DateTime? @map("original_due_at")
  id           String                  @id @default(cuid())
  batchId      String                  @map("batch_id")
  storeId      String                  @map("store_id")
  store        V2Store                 @relation(fields: [storeId], references: [id])
  targetKey    String                  @map("target_key")
  targetName   String                  @map("target_name")
  title        String                  @db.VarChar(120)
  description  String                  @db.Text
  dueAt        DateTime                @map("due_at")
  status       V2OperationalTaskStatus @default(PENDING)
  createdBy    String                  @map("created_by")
  createdAt    DateTime                @default(now()) @map("created_at")
  claimerId    String?                 @map("claimer_id")
  claimerName  String?                 @map("claimer_name")
  claimedAt    DateTime?               @map("claimed_at")
  submission   String?                 @db.Text
  submittedAt  DateTime?               @map("submitted_at")
  reviewedBy   String?                 @map("reviewed_by")
  reviewedAt   DateTime?               @map("reviewed_at")

  @@unique([createdBy, batchId, storeId, targetKey], map: "v2_operational_tasks_dispatch_key")
  @@index([storeId, targetKey, dueAt], map: "v2_operational_tasks_target_idx")
  @@index([createdAt])
  @@index([sourceTaskId])
  @@unique([scheduleId, scheduledFor], map: "v2_operational_task_schedule_slot_key")
  @@map("v2_operational_tasks")
}

model V2OperationalTaskReopen {
  checklistIssues Json? @map("checklist_issues")
  action V2OperationalTaskReopenAction @default(RETURN)
  previousClaimedAt DateTime? @map("previous_claimed_at")
  checklistConfirmed Boolean @default(false) @map("checklist_confirmed")
  evidence V2OperationalTaskEvidence[]
  id                  String            @id @default(cuid())
  taskId              String            @map("task_id")
  task                V2OperationalTask @relation(fields: [taskId], references: [id])
  actorId             String            @map("actor_id")
  reason              String            @db.Text
  previousClaimerId   String?           @map("previous_claimer_id")
  previousClaimerName String?           @map("previous_claimer_name")
  previousSubmission  String?           @map("previous_submission") @db.Text
  previousSubmittedAt DateTime?         @map("previous_submitted_at")
  previousDueAt        DateTime          @map("previous_due_at")
  newDueAt             DateTime          @map("new_due_at")
  createdAt            DateTime          @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("v2_operational_task_reopens")
}

model V2OperationalTaskEvidence {
  id          String                   @id @default(cuid())
  taskId      String                   @map("task_id")
  task        V2OperationalTask        @relation(fields: [taskId], references: [id])
  reopenId    String?                  @map("reopen_id")
  reopen      V2OperationalTaskReopen? @relation(fields: [reopenId], references: [id], onDelete: Restrict)
  image       Bytes?                   @db.MediumBlob
  storageProvider V2OperationalTaskEvidenceStorage @default(DATABASE) @map("storage_provider")
  objectKey   String?                  @unique @map("object_key") @db.VarChar(191)
  etag        String?                  @db.VarChar(191)
  checksumSha256 String?               @map("checksum_sha256") @db.Char(64)
  contentType String                   @default("image/jpeg") @map("content_type") @db.VarChar(64)
  checklistItemId String?              @map("checklist_item_id") @db.VarChar(64)
  byteSize    Int                      @default(0) @map("byte_size")
  width       Int?
  height      Int?
  createdAt   DateTime                 @default(now()) @map("created_at")

  @@index([taskId, reopenId])
  @@index([taskId, checklistItemId])
  @@index([reopenId])
  @@map("v2_operational_task_evidence")
}

model V2OperationalTaskEvidenceDraft {
  id              String            @id @default(cuid())
  taskId          String            @map("task_id")
  task            V2OperationalTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId      String            @map("employee_id")
  employee        V2Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checklistItemId String?           @map("checklist_item_id") @db.VarChar(64)
  objectKey       String            @unique @map("object_key") @db.VarChar(191)
  etag            String?           @db.VarChar(191)
  checksumSha256  String            @map("checksum_sha256") @db.Char(64)
  contentType     String            @default("image/jpeg") @map("content_type") @db.VarChar(64)
  byteSize        Int               @map("byte_size")
  width           Int?
  height          Int?
  expiresAt       DateTime          @map("expires_at")
  cleanupClaimedAt DateTime?        @map("cleanup_claimed_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([taskId, employeeId, expiresAt])
  @@index([expiresAt, cleanupClaimedAt])
  @@map("v2_operational_task_evidence_drafts")
}

enum V2OperationalTaskEvidenceStorage {
  DATABASE
  S3
}

enum V2OperationalTaskCadence {
  DAILY
  WEEKLY
  MONTHLY
}

model V2OperationalTaskSchedule {
  referenceImages Json? @map("reference_images")
  category String? @db.VarChar(40)
  archivedAt DateTime? @map("archived_at")
  ccRecipients Json? @map("cc_recipients")
  checklist Json?
  batchId       String                   @map("batch_id") @db.VarChar(64)
  reviewMode    V2OperationalTaskReviewMode @default(REQUIRED) @map("review_mode")
  id            String                   @id @default(cuid())
  storeId       String                   @map("store_id")
  store         V2Store                  @relation(fields: [storeId], references: [id])
  targetKey     String                   @map("target_key")
  targetName    String                   @map("target_name")
  title         String                   @db.VarChar(120)
  description   String                   @db.Text
  cadence       V2OperationalTaskCadence
  firstRunAt    DateTime                 @map("first_run_at")
  nextRunAt     DateTime                 @map("next_run_at")
  dueHours      Int                      @map("due_hours")
  enabled       Boolean                  @default(true)
  pauseReason   String?                  @map("pause_reason") @db.VarChar(191)
  createdBy     String                   @map("created_by")
  scheduledBy   String                   @map("scheduled_by")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
