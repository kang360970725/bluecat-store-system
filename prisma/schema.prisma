  @@index([enabled, nextRunAt])
  @@index([storeId, createdAt])
  @@unique([createdBy, batchId, storeId, targetKey], map: "v2_operational_task_schedules_batch_target_key")
  @@map("v2_operational_task_schedules")
}

model V2OperationalTaskExecutorGroup {
