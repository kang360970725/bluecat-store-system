generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DataScope {
  ALL
  ORG
  STORE
  SELF
  CUSTOM_STORES
}

enum StoreStatus {
  ENABLED
  DISABLED
}

enum StoreAreaLevel {
  LOW
  MID
  HIGH
}

enum MemberPriceTier {
  TEMPORARY
  NORMAL_MEMBER
  BLUECAT_MEMBER
  EXTRAORDINARY_MEMBER
  APEX_MEMBER
  PLATINUM_MEMBER
  BLACK_GOLD_MEMBER
  MYTHIC_MEMBER
}

enum PerformanceSplitStatus {
  PENDING
  ACTIVE
}

enum PerformanceTargetMode {
  MANUAL
  ABSOLUTE_PROFIT
  HISTORICAL_GROWTH
}

enum ScheduleRole {
  CASHIER
  FLOOR
  FLEX
}

enum ExternalMappingStatus {
  AUTO_MATCHED
  MANUAL_MATCHED
  UNMATCHED
}

enum V2IngestStatus {
  RECEIVED
  COMPLETED
  FAILED
}

enum V2EventType {
  RECHARGE_PRINCIPAL
  RECHARGE_DIRECT_REWARD
  MARKETING_CREDIT
  PRODUCT_SALE
  PRODUCT_REFUND
  OTA_REDEEM
  OTA_REVERSE
  NET_FEE_SETTLEMENT
  LEASE_INCOME
  OTHER_INCOME
}

enum V2Decision {
  INCLUDED
  EXCLUDED
}

enum V2LinkType {
  DUPLICATE_OF
  REPRESENTS_SAME_BUSINESS
  REVERSAL_OF
}

enum V2ReconciliationStatus {
  DRAFT
  PASSED
  NEEDS_REVIEW
}

enum V2OrgType {
  HEADQUARTERS
  REGION
  COMPANY
}

enum V2StoreStatus {
  PREPARING
  OPERATING
  SUSPENDED
  CLOSED
}

enum V2ExternalStoreCandidateStatus {
  PENDING
  MATCHED
  IGNORED
}

enum V2PositionSource {
  SYSTEM_TEMPLATE
  STORE_CUSTOM
}

enum V2EmployeeStatus {
  PENDING
  ACTIVE
  LEAVE
  TERMINATED
}

enum V2EmploymentChangeType {
  HIRED
  TRANSFERRED
  POSITION_CHANGED
  STATUS_CHANGED
  TERMINATED
}

enum V2LeaveType {
  ANNUAL
  SICK
  PERSONAL
  COMPENSATORY
  OTHER
}

enum V2LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum V2CostCalculationMethod {
  FIXED
  RATE
  FORMULA
  MANUAL
}

enum V2CostFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum V2InvestmentType {
  INITIAL
  ADDITIONAL
  RENOVATION
  EQUIPMENT
  OTHER
}

enum V2AssetStatus {
  ACTIVE
  REPAIRING
  RETIRED
  DISPOSED
}

enum V2AccountStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum V2DataScopeType {
  ALL_STORES
  ASSIGNED_STORES
  EMPLOYEE_STORE
}

enum V2PayrollBatchStatus {
  DRAFT
  CALCULATED
  PENDING_REVIEW
  REVIEWED
  APPROVED
  LOCKED
  PAID
  CANCELLED
}

enum V2PayrollAdjustmentDirection {
  EARNING
  DEDUCTION
}

enum V2PayrollAdjustmentStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum V2PlanStatus {
  DRAFT
  PUBLISHED
  LOCKED
}

enum V2ScoreStatus {
  DRAFT
  CONFIRMED
}

enum V2SourceSessionStatus {
  UNCONFIGURED
  VALID
  EXPIRED
  ERROR
}

enum V2SyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum V2RevenueSnapshotKind {
  SETTLED_DAILY
  LIVE_TODAY
}

model Org {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  parentId  String?   @map("parent_id")
  parent    Org?      @relation("OrgTree", fields: [parentId], references: [id])
  children  Org[]     @relation("OrgTree")
  stores    Store[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  @@map("orgs")
}

model Store {
  id                    String                                @id @default(cuid())
  orgId                 String                                @map("org_id")
  org                   Org                                   @relation(fields: [orgId], references: [id])
  name                  String
  code                  String                                @unique
  status                StoreStatus                           @default(ENABLED)
  machineCount          Int                                   @default(0) @map("machine_count")
  address               String?
  longitude             Decimal?                              @db.Decimal(10, 6)
  latitude              Decimal?                              @db.Decimal(10, 6)
  phone                 String?
  managerEmployeeId     String?                               @map("manager_employee_id")
  managerEmployee       Employee?                             @relation("StoreManager", fields: [managerEmployeeId], references: [id])
  responsibleEmployeeId String?                               @map("responsible_employee_id")
  responsibleEmployee   Employee?                             @relation("StoreResponsible", fields: [responsibleEmployeeId], references: [id])
  employees             Employee[]                            @relation("StoreEmployees")
  areas                 StoreArea[]
  performanceTargets    StorePerformanceTarget[]
  performanceActuals    StorePerformanceActualSnapshot[]
  performanceEstimates  StorePerformanceEstimateSnapshot[]
  splitPlans            StorePerformanceSplitPlan[]
  shiftActuals          StorePerformanceShiftActualSnapshot[]
  legacyExternalMappings StoreExternalMapping[]
  schedules             EmployeeSchedule[]
  scoreEntries          StoreScoreEntry[]
  createdAt             DateTime                              @default(now()) @map("created_at")
  updatedAt             DateTime                              @updatedAt @map("updated_at")
  createdBy             String?                               @map("created_by")
  updatedBy             String?                               @map("updated_by")
  deletedAt             DateTime?                             @map("deleted_at")

  @@index([orgId])
  @@index([managerEmployeeId])
  @@index([responsibleEmployeeId])
  @@map("stores")
}

model User {
  id           String     @id @default(cuid())
  orgId        String?    @map("org_id")
  storeId      String?    @map("store_id")
  username     String     @unique
  passwordHash String     @map("password_hash")
  nickname     String
  enabled      Boolean    @default(true)
  roles        UserRole[]
  employee     Employee?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String?    @map("created_by")
  updatedBy    String?    @map("updated_by")
  deletedAt    DateTime?  @map("deleted_at")

  @@index([orgId])
  @@index([storeId])
  @@map("users")
}

model Employee {
  id                String             @id @default(cuid())
  storeId           String             @map("store_id")
  store             Store              @relation("StoreEmployees", fields: [storeId], references: [id])
  userId            String?            @unique @map("user_id")
  user              User?              @relation(fields: [userId], references: [id])
  positionId        String?            @map("position_id")
  positionRef       Position?          @relation(fields: [positionId], references: [id])
  employeeNo        String             @unique @map("employee_no")
  name              String
  phone             String?
  position          String?
  enabled           Boolean            @default(true)
  managedStores     Store[]            @relation("StoreManager")
  responsibleStores Store[]            @relation("StoreResponsible")
  schedules         EmployeeSchedule[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  createdBy         String?            @map("created_by")
  updatedBy         String?            @map("updated_by")
  deletedAt         DateTime?          @map("deleted_at")

  @@index([storeId])
  @@index([positionId])
  @@map("employees")
}

model Position {
  id          String               @id @default(cuid())
  name        String
  code        String               @unique
  description String?
  permissions PositionPermission[]
  employees   Employee[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  createdBy   String?              @map("created_by")
  updatedBy   String?              @map("updated_by")
  deletedAt   DateTime?            @map("deleted_at")

  @@map("positions")
}

model StoreArea {
  id           String           @id @default(cuid())
  storeId      String           @map("store_id")
  store        Store            @relation(fields: [storeId], references: [id])
  name         String
  code         String
  level        StoreAreaLevel
  machineCount Int              @default(0) @map("machine_count")
  gpuModel     String?          @map("gpu_model")
  cpuModel     String?          @map("cpu_model")
  monitorModel String?          @map("monitor_model")
  prices       StoreAreaPrice[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  createdBy    String?          @map("created_by")
  updatedBy    String?          @map("updated_by")
  deletedAt    DateTime?        @map("deleted_at")

  @@unique([storeId, code])
  @@index([storeId])
  @@map("store_areas")
}

model StoreAreaPrice {
  id        String          @id @default(cuid())
  areaId    String          @map("area_id")
  area      StoreArea       @relation(fields: [areaId], references: [id])
  tier      MemberPriceTier
  price     Decimal         @db.Decimal(10, 2)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  createdBy String?         @map("created_by")
  updatedBy String?         @map("updated_by")
  deletedAt DateTime?       @map("deleted_at")

  @@unique([areaId, tier])
  @@index([areaId])
  @@map("store_area_prices")
}

model StorePerformanceTarget {
  id                    String                     @id @default(cuid())
  storeId               String                     @map("store_id")
  store                 Store                      @relation(fields: [storeId], references: [id])
  month                 DateTime                   @db.Date
  targetRevenue         Decimal                    @default(0) @map("target_revenue") @db.Decimal(12, 2)
  netFeeTarget          Decimal                    @default(0) @map("net_fee_target") @db.Decimal(12, 2)
  productTarget         Decimal                    @default(0) @map("product_target") @db.Decimal(12, 2)
  drinkTarget           Decimal                    @default(0) @map("drink_target") @db.Decimal(12, 2)
  mealTarget            Decimal                    @default(0) @map("meal_target") @db.Decimal(12, 2)
  otherTarget           Decimal                    @default(0) @map("other_target") @db.Decimal(12, 2)
  targetMode            PerformanceTargetMode      @default(MANUAL) @map("target_mode")
  targetProfit          Decimal                    @default(0) @map("target_profit") @db.Decimal(12, 2)
  profitGrowthRate      Decimal?                   @map("profit_growth_rate") @db.Decimal(7, 4)
  totalCostBudget       Decimal                    @default(0) @map("total_cost_budget") @db.Decimal(12, 2)
  expectedVisits        Int                        @default(0) @map("expected_visits")
  managementFeeRate     Decimal                    @default(0.09) @map("management_fee_rate") @db.Decimal(7, 4)
  splitStatus           PerformanceSplitStatus     @default(PENDING) @map("split_status")
  splitPlan             StorePerformanceSplitPlan?
  managementFee         Decimal                    @default(0) @map("management_fee") @db.Decimal(12, 2)
  rent                  Decimal                    @default(0) @db.Decimal(12, 2)
  propertyTrashFee      Decimal                    @default(0) @map("property_trash_fee") @db.Decimal(12, 2)
  utilities             Decimal                    @default(0) @db.Decimal(12, 2)
  drinkMaterial         Decimal                    @default(0) @map("drink_material") @db.Decimal(12, 2)
  mealMaterial          Decimal                    @default(0) @map("meal_material") @db.Decimal(12, 2)
  welfare               Decimal                    @default(0) @db.Decimal(12, 2)
  salary                Decimal                    @default(0) @db.Decimal(12, 2)
  franchiseFee          Decimal                    @default(0) @map("franchise_fee") @db.Decimal(12, 2)
  baseOperationSoftware Decimal                    @default(0) @map("base_operation_software") @db.Decimal(12, 2)
  storeOperation        Decimal                    @default(0) @map("store_operation") @db.Decimal(12, 2)
  advertisingMaterial   Decimal                    @default(0) @map("advertising_material") @db.Decimal(12, 2)
  financeTax            Decimal                    @default(0) @map("finance_tax") @db.Decimal(12, 2)
  withdrawalFee         Decimal                    @default(0) @map("withdrawal_fee") @db.Decimal(12, 2)
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  createdBy             String?                    @map("created_by")
  updatedBy             String?                    @map("updated_by")
  deletedAt             DateTime?                  @map("deleted_at")

  @@unique([storeId, month])
  @@index([month])
  @@map("store_performance_targets")
}

model WorkShift {
  id         String                                @id @default(cuid())
  name       String
  code       String                                @unique
  sort       Int                                   @default(0)
  startTime  String?                               @map("start_time")
  endTime    String?                               @map("end_time")
  schedules  EmployeeSchedule[]
  splitItems StorePerformanceSplitItem[]
  actuals    StorePerformanceShiftActualSnapshot[]
  createdAt  DateTime                              @default(now()) @map("created_at")
  updatedAt  DateTime                              @updatedAt @map("updated_at")
  deletedAt  DateTime?                             @map("deleted_at")

  @@map("work_shifts")
}

model EmployeeSchedule {
  id         String       @id @default(cuid())
  storeId    String       @map("store_id")
  store      Store        @relation(fields: [storeId], references: [id])
  employeeId String       @map("employee_id")
  employee   Employee     @relation(fields: [employeeId], references: [id])
  shiftId    String       @map("shift_id")
  shift      WorkShift    @relation(fields: [shiftId], references: [id])
  role       ScheduleRole
  workDate   DateTime     @map("work_date") @db.Date
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  deletedAt  DateTime?    @map("deleted_at")

  @@unique([storeId, shiftId, workDate, role])
  @@index([storeId, workDate])
  @@index([employeeId])
  @@index([shiftId])
  @@map("employee_schedules")
}

model StorePerformanceSplitPlan {
  id                  String                      @id @default(cuid())
  storeId             String                      @map("store_id")
  store               Store                       @relation(fields: [storeId], references: [id])
  targetId            String                      @unique @map("target_id")
  target              StorePerformanceTarget      @relation(fields: [targetId], references: [id])
  month               DateTime                    @db.Date
  netFeeTarget        Decimal                     @default(0) @map("net_fee_target") @db.Decimal(12, 2)
  productTarget       Decimal                     @default(0) @map("product_target") @db.Decimal(12, 2)
  weekendIncreaseRate Decimal                     @default(0.15) @map("weekend_increase_rate") @db.Decimal(5, 4)
  shiftMode           Int                         @default(2) @map("shift_mode")
  lastRebalancedAt    DateTime?                   @map("last_rebalanced_at")
  status              PerformanceSplitStatus      @default(ACTIVE)
  items               StorePerformanceSplitItem[]
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  createdBy           String?                     @map("created_by")
  updatedBy           String?                     @map("updated_by")
  deletedAt           DateTime?                   @map("deleted_at")

  @@unique([storeId, month])
  @@index([month])
  @@map("store_performance_split_plans")
}

model StorePerformanceSplitItem {
  id               String                                @id @default(cuid())
  planId           String                                @map("plan_id")
  plan             StorePerformanceSplitPlan             @relation(fields: [planId], references: [id])
  shiftId          String                                @map("shift_id")
  shift            WorkShift                             @relation(fields: [shiftId], references: [id])
  workDate         DateTime                              @map("work_date") @db.Date
  netFeeTarget     Decimal                               @default(0) @map("net_fee_target") @db.Decimal(12, 2)
  productTarget    Decimal                               @default(0) @map("product_target") @db.Decimal(12, 2)
  allocationWeight Decimal                               @default(1) @map("allocation_weight") @db.Decimal(7, 3)
  lockedAt         DateTime?                             @map("locked_at")
  actuals          StorePerformanceShiftActualSnapshot[]
  createdAt        DateTime                              @default(now()) @map("created_at")
  updatedAt        DateTime                              @updatedAt @map("updated_at")
  deletedAt        DateTime?                             @map("deleted_at")

  @@unique([planId, shiftId, workDate])
  @@index([workDate])
  @@index([shiftId])
  @@map("store_performance_split_items")
}

model StorePerformanceShiftActualSnapshot {
  id            String                     @id @default(cuid())
  storeId       String                     @map("store_id")
  store         Store                      @relation(fields: [storeId], references: [id])
  splitItemId   String?                    @map("split_item_id")
  splitItem     StorePerformanceSplitItem? @relation(fields: [splitItemId], references: [id])
  shiftId       String                     @map("shift_id")
  shift         WorkShift                  @relation(fields: [shiftId], references: [id])
  workDate      DateTime                   @map("work_date") @db.Date
  netFeeActual  Decimal                    @default(0) @map("net_fee_actual") @db.Decimal(12, 2)
  productActual Decimal                    @default(0) @map("product_actual") @db.Decimal(12, 2)
  source        String                     @default("realtime") @map("source")
  syncedAt      DateTime?                  @map("synced_at")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  deletedAt     DateTime?                  @map("deleted_at")

  @@unique([storeId, shiftId, workDate, source])
  @@index([workDate])
  @@index([splitItemId])
  @@map("store_performance_shift_actual_snapshots")
}

model StorePerformanceActualSnapshot {
  id              String    @id @default(cuid())
  storeId         String    @map("store_id")
  store           Store     @relation(fields: [storeId], references: [id])
  month           DateTime  @db.Date
  amount          Decimal   @default(0) @db.Decimal(12, 2)
  source          String    @default("third_party") @map("source")
  dataThroughDate DateTime? @map("data_through_date") @db.Date
  syncedAt        DateTime? @map("synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@unique([storeId, month, source])
  @@index([month])
  @@map("store_performance_actual_snapshots")
}

model StorePerformanceEstimateSnapshot {
  id        String    @id @default(cuid())
  storeId   String    @map("store_id")
  store     Store     @relation(fields: [storeId], references: [id])
  month     DateTime  @db.Date
  amount    Decimal   @default(0) @db.Decimal(12, 2)
  source    String    @default("split_plan") @map("source")
  syncedAt  DateTime? @map("synced_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([storeId, month, source])
  @@index([month])
  @@map("store_performance_estimate_snapshots")
}

/// Historical read-only archive. New code must use V2DataSourceConnection.
model StoreExternalMapping {
  id               String                @id @default(cuid())
  provider         String                @default("54laoban")
  externalStoreId  String                @map("external_store_id")
  externalBranchId String?               @map("external_branch_id")
  externalName     String?               @map("external_name")
  storeId          String?               @map("store_id")
  store            Store?                @relation(fields: [storeId], references: [id], onDelete: SetNull)
  matchStatus      ExternalMappingStatus @default(UNMATCHED) @map("match_status")
  lastSeenAt       DateTime?             @map("last_seen_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  deletedAt        DateTime?             @map("deleted_at")

  @@unique([provider, externalStoreId])
  @@index([storeId])
  @@map("legacy_store_external_mappings_archive")
}

model PerformanceSyncLog {
  id          String    @id @default(cuid())
  provider    String    @default("54laoban")
  syncType    String    @map("sync_type")
  status      String
  paramsJson  Json?     @map("params_json")
  resultJson  Json?     @map("result_json")
  errorReason String?   @map("error_reason") @db.Text
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([provider, syncType, startedAt])
  @@map("performance_sync_logs")
}

model V2IngestBatch {
  id              String         @id @default(cuid())
  sourceSystem    String         @map("source_system")
  endpoint        String
  externalStoreId String         @map("external_store_id")
  requestParams   Json           @map("request_params")
  responseBody    Json           @map("response_body")
  businessStartAt DateTime       @map("business_start_at")
  businessEndAt   DateTime       @map("business_end_at")
  fetchedAt       DateTime       @map("fetched_at")
  status          V2IngestStatus @default(RECEIVED)
  pageCount       Int?           @map("page_count")
  recordCount     Int            @default(0) @map("record_count")
  contentHash     String         @map("content_hash") @db.VarChar(64)
  rawRecords      V2RawRecord[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([sourceSystem, endpoint, externalStoreId, contentHash])
  @@index([externalStoreId, businessStartAt, businessEndAt])
  @@map("v2_ingest_batches")
}

model V2Organization {
  id          String                     @id @default(cuid())
  parentId    String?                    @map("parent_id")
  parent      V2Organization?            @relation("V2OrganizationTree", fields: [parentId], references: [id])
  children    V2Organization[]           @relation("V2OrganizationTree")
  type        V2OrgType
  name        String
  code        String                     @unique
  enabled     Boolean                    @default(true)
  stores      V2Store[]
  positions   V2OrganizationPosition[]
  employments V2OrganizationEmployment[]
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  createdBy   String?                    @map("created_by")
  updatedBy   String?                    @map("updated_by")
  deletedAt   DateTime?                  @map("deleted_at")

  @@index([parentId])
  @@map("v2_organizations")
}

model V2OrganizationPosition {
  id             String                     @id @default(cuid())
  organizationId String                     @map("organization_id")
  organization   V2Organization             @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  description    String?                    @db.Text
  sort           Int                        @default(0)
  enabled        Boolean                    @default(true)
  requiresPGrade Boolean                    @default(false) @map("requires_p_grade")
  roleId         String?                    @map("role_id")
  role           V2Role?                    @relation("V2OrganizationPositionRole", fields: [roleId], references: [id], onDelete: SetNull)
  employments    V2OrganizationEmployment[]
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  createdBy      String?                    @map("created_by")
  updatedBy      String?                    @map("updated_by")
  deletedAt      DateTime?                  @map("deleted_at")

  @@unique([organizationId, code])
  @@index([roleId])
  @@map("v2_organization_positions")
}

model V2OrganizationEmployment {
  id             String                 @id @default(cuid())
  employeeId     String                 @map("employee_id")
  employee       V2Employee             @relation(fields: [employeeId], references: [id])
  organizationId String                 @map("organization_id")
  organization   V2Organization         @relation(fields: [organizationId], references: [id])
  positionId     String                 @map("position_id")
  position       V2OrganizationPosition @relation(fields: [positionId], references: [id])
  costStoreId    String?                @map("cost_store_id")
  costStore      V2Store?               @relation("V2OrganizationEmploymentCostStore", fields: [costStoreId], references: [id])
  grade          String?                @db.VarChar(12)
  compensationType String               @default("MONTHLY") @map("compensation_type") @db.VarChar(12)
  startedOn      DateTime               @map("started_on") @db.Date
  endedOn        DateTime?              @map("ended_on") @db.Date
  isPrimary      Boolean                @default(true) @map("is_primary")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  createdBy      String?                @map("created_by")
  updatedBy      String?                @map("updated_by")
  deletedAt      DateTime?              @map("deleted_at")

  @@index([employeeId, startedOn, endedOn])
  @@index([organizationId, positionId, endedOn])
  @@index([costStoreId, endedOn])
  @@map("v2_organization_employments")
}

model V2Store {
  operationalTaskSchedules V2OperationalTaskSchedule[]
  operationalTasks V2OperationalTask[]
  operationalTaskExecutorGroups V2OperationalTaskExecutorGroup[]
